  @override
  void initState() {
    super.initState();

    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 400),
    );

    _shakeAnimation = Tween<double>(
      begin: 0,
      end: 10,
    ).animate(CurvedAnimation(parent: _controller, curve: Curves.elasticIn));
  }

  // ⏰ INICIAR TIMER
  void iniciarTimer() {
    _timer?.cancel();

    setState(() {
      tempoRestante = 30;
    });

    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      // 🚨 BLOQUEIO TOTAL (evita qualquer mudança durante explicação)
      if (mostrarExplicacao || gameOver || quizFinalizado) {
        timer.cancel();
        return;
      }

      if (tempoRestante > 0) {
        setState(() {
          tempoRestante--;
        });
        return;
      }

      // ⏰ TEMPO ESGOTADO
      timer.cancel();

      // 🚨 SEGURANÇA EXTRA (evita avanço durante explicação)
      if (mostrarExplicacao || gameOver || quizFinalizado) return;

      if (perguntaAtual < perguntas.length - 1) {
        setState(() {
          perguntaAtual++;
          mensagem = null;
          respostaSelecionada = null;
        });

        iniciarTimer();
      } else {
        setState(() {
          quizFinalizado = true;
        });
      }
    });
  }

  void verificarResposta(String respostaEscolhida) {
    _timer?.cancel();

    String correta = perguntas[perguntaAtual]['respostaCorreta'];

    setState(() {
      respostaSelecionada = respostaEscolhida;

      if (respostaEscolhida == correta) {
        pontos++;
        mensagem = '✔ Correto!';
      } else {
        vidas--;
        mensagem = '✖ Errado!';
        _controller.forward(from: 0);

        _timer?.cancel();
        mostrarExplicacao = true;

        if (vidas <= 0) {
          gameOver = true;
        }
      }
    });

    Future.delayed(const Duration(seconds: 1), () {
      // 🚨 NÃO AVANÇA se estiver mostrando explicação
      if (mostrarExplicacao) return;

      setState(() {
        mensagem = null;
        respostaSelecionada = null;

        if (gameOver) return;

        if (perguntaAtual < perguntas.length - 1) {
          perguntaAtual++;
          iniciarTimer();
        } else {
          quizFinalizado = true;
        }
      });
    });
  }

  void continuarDepoisExplicacao() {
    setState(() {
      mostrarExplicacao = false;
      mensagem = null;
      respostaSelecionada = null;

      if (perguntaAtual < perguntas.length - 1) {
        perguntaAtual++;
        iniciarTimer();
      } else {
        quizFinalizado = true;
      }
    });
  }

  Color corOpcao(String opcao) {
    String correta = perguntas[perguntaAtual]['respostaCorreta'];

    if (respostaSelecionada == null) {
      return Colors.white;
    }

    if (opcao == correta) return Colors.green;
    if (opcao == respostaSelecionada) return Colors.red;

    return Colors.white;
  }

